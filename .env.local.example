# Local Supabase values: run `npx supabase status` in your existing project.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
# Server only. NEVER prefix this with NEXT_PUBLIC_ or expose it to browser code.
SUPABASE_SECRET_KEY=replace-with-local-secret-key
# Auth confirmation emails redirect to this app origin. In production, set this to your deployed HTTPS origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Razorpay TEST credentials. Keep these private and never commit .env.local.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me
